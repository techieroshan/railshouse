		<section class="row-am blog-home" id="blog-home">

			<div class="container">

				<div class="cl-sm-12 sol-md-12 col-lg-12">

					<div class="main-heading wow fadeInDown">

						<h1>Latest from the blog</h1>

					</div>

				</div>

				<div class="three-blog row">
					<% Article.published.limit(3).each do |article| %>
					<div class="col-sm-12 col-md-4 col-lg-4 blog-single">

						<div class="blog-single-inner">

							<div class="blog-img">

								<%= image_tag "blog#{rand(1..4)}.png", alt: article.title %>

							</div>

							<div class="blog-cont-wrapper">

								<div class="date"><%= article.published_at.day %>

									<br><span class="month font-uppercase"><%= article.published_at.strftime('%b') %></span>

								</div>

								<div class="blog-name"><%= link_to article.title, article_path(article) %></div>

								<p><%= truncate(strip_tags(article.content), length: 180) %></p>

								<div class="blog-btn">

									<%= link_to article_path(article), aria: { label: "Read more about #{article.title}" } do %>

										<%= image_tag "red-right.png", alt: "Read More" %>

									<% end %>

								</div>

							</div>

						</div>

					</div>
					<% end %>

				</div>

			</div>

			<!--container-->

		</section>
