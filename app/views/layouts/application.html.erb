<!DOCTYPE html>
<html lang="en">
  <head>
    <%= display_meta_tags %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render(:partial => 'layouts/headmeta') %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'main-styles', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
    
    <!-- Structured Data -->
    <script type="application/ld+json">
      <%= structured_data_organization %>
    </script>
    
    <%= yield :head %>
  </head>

  <body>
    <a href="#content" class="skip-link">Skip to main content</a>
    <%= yield %>
    <%= render(:partial => 'layouts/footerbottom') %>
  </body>
</html>
