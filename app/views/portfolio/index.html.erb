<%= render(:partial => 'layouts/headermenu') %>

<div class="jumbotron in-ban portfolio">
  <div class="container">
    <div class="ban-text">
      <div class="updates">Take a look at our cool Projects</div>
      <h1>RailsHouse Portfolio</h1>
    </div>
  </div>
</div>

<!-- Content -->
<div id="content" class="about-us-wrap gray-bg">
  <div class="alert alert-warning text-center" style="margin-bottom: 30px;">
    <strong>Disclaimer:</strong> All case studies shown below are indicative examples for demonstration purposes only. They do not represent real client projects or results.
  </div>
  <section class="breadcrumb-wrap">
    <div class="container">
      <div class="row">
        <nav aria-label="breadcrumb" class="brd">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><%= link_to 'Home', root_path %></li>
            <li class="breadcrumb-item active" aria-current="page">Portfolio</li>
          </ol>
        </nav>
      </div>
    </div>
  </section>

  <section class="row-am portfolio-wrap" id="portfolio-wrap">
    <div class="container-fluid">
      <% if @portfolios.present? %>
        <% @portfolios.each_with_index do |portfolio, index| %>
          <% side_class = index.even? ? 'left-side' : 'right-side' %>
          <% number = sprintf('%02d', index + 1) %>
          
          <div class="port1 row <%= side_class %>">
            <% if index.even? %>
              <!-- Image on right for even items -->
              <div class="col-md-12 col-lg-6 col-sm-12 left p-0 white-bg float-right port-image">
                <div class="port-images">
                  <%= image_tag "port#{(index % 2) + 1}.png", alt: portfolio.title %>
                </div>
              </div>
              <div class="col-md-12 col-lg-6 col-sm-12 right p-0 port-cont-wrap">
                <div class="col-md-12 col-lg-7 col-sm-12 port-cont white-bg float-left">
                  <div class="number">
                    <div class="number-inner"><%= number %></div>
                  </div>
                  <div class="port-title"><%= link_to portfolio.title, portfolio_path(portfolio) %></div>
                  <p><%= truncate(portfolio.description, length: 250) %></p>
                  <div class="tech-title">Industry</div>
                  <p class="industry-tag"><strong><%= portfolio.industry %></strong></p>
                  <div class="tech-title">Client</div>
                  <p class="client-tag"><strong><%= portfolio.client %></strong></p>
                  <%= link_to 'Read Case Study', portfolio_path(portfolio), class: 'red-btn hvr-radial-in read-more', 
                      'aria-label': "Read full case study for #{portfolio.title}" %>
                </div>
              </div>
            <% else %>
              <!-- Image on left for odd items -->
              <div class="col-md-12 col-lg-6 col-sm-12 left p-0 port-cont-wrap">
                <div class="col-md-12 col-lg-7 col-sm-12 port-cont white-bg float-right">
                  <div class="number">
                    <div class="number-inner"><%= number %></div>
                  </div>
                  <div class="port-title"><%= link_to portfolio.title, portfolio_path(portfolio) %></div>
                  <p><%= truncate(portfolio.description, length: 250) %></p>
                  <div class="tech-title">Industry</div>
                  <p class="industry-tag"><strong><%= portfolio.industry %></strong></p>
                  <div class="tech-title">Client</div>
                  <p class="client-tag"><strong><%= portfolio.client %></strong></p>
                  <%= link_to 'Read Case Study', portfolio_path(portfolio), class: 'red-btn hvr-radial-in read-more',
                      'aria-label': "Read full case study for #{portfolio.title}" %>
                </div>
              </div>
              <div class="col-md-12 col-lg-6 col-sm-12 right p-0 white-bg float-left port-image">
                <div class="port-images">
                  <%= image_tag "port#{(index % 2) + 1}.png", alt: portfolio.title %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
        
        <!-- Pagination -->
        <div class="row">
          <div class="col-12 text-center mt-5 mb-5">
            <%= paginate @portfolios %>
          </div>
        </div>
      <% else %>
        <div class="row">
          <div class="col-12 text-center">
            <h3>No portfolio items available at this time.</h3>
            <p>Check back soon for our latest case studies and success stories.</p>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <%= render(:partial => 'layouts/sec8interestedblock') %>
</div>

<%= render(:partial => 'layouts/footerjsblock') %>
<%= render(:partial => 'layouts/jsfooterportfolio') %>
