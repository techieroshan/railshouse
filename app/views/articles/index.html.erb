<%= render(:partial => 'layouts/headermenu') %>

<div class="jumbotron in-ban">
  <div class="container">
    <div class="ban-text">
      <div class="updates">Articles</div>
      <h1>Latest Article Posts</h1>
    </div>
  </div>
</div>

<!-- Content -->
<main id="content" role="main">
  <section class="breadcrumb-wrap gray-bg">
    <div class="container">
      <div class="row">
        <nav aria-label="breadcrumb" class="brd">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><%= link_to 'Home', root_path %></li>
            <% if @current_category.present? %>
              <li class="breadcrumb-item"><%= link_to 'Articles', articles_path %></li>
              <li class="breadcrumb-item active" aria-current="page"><%= @current_category %></li>
            <% elsif @current_archive.present? %>
              <li class="breadcrumb-item"><%= link_to 'Articles', articles_path %></li>
              <li class="breadcrumb-item active" aria-current="page"><%= @current_archive %></li>
            <% else %>
              <li class="breadcrumb-item active" aria-current="page">Articles</li>
            <% end %>
          </ol>
        </nav>
      </div>
    </div>
  </section>

  <!-- Section 1 -->
  <section class="row blog2" id="blog-inner">
    <div class="container">
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-8">
          <div class="row">
            <% if @articles.any? %>
              <% @articles.each do |article| %>
                <% article_date = article.published_at || article.created_at || Time.current %>
                <div class="col-md-6 col-sm-12 col-lg-6 blog-single">
                  <div class="blog-single-inner">
                    <div class="blog-img">
                      <%= image_tag "blog#{rand(1..4)}.png", alt: article.title %>
                    </div>
                    <div class="blog-cont-wrapper">
                      <div class="date"><%= article_date.day %>
                        <br><span class="month font-uppercase"><%= article_date.strftime('%b') %></span>
                      </div>
                      <div class="blog-name"><%= link_to article.title, article_path(article) %></div>
                      <% if article.category.present? %>
                        <div class="blog-category">
                          <%= link_to article.category, category_articles_path(category: article.category), class: 'category-tag' %>
                        </div>
                      <% end %>
                      <p><%= truncate(strip_tags(article.content), length: 150) %></p>
                      <div class="blog-btn">
                        <%= link_to article_path(article), aria: { label: "Read more about #{article.title}" } do %>
                          <%= image_tag "red-right.png", alt: "Read More" %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="col-12">
                <p class="text-center">No articles found.</p>
              </div>
            <% end %>
          </div>
          <!--row end-->

          <!-- Pagination -->
          <% if @articles.total_pages > 1 %>
            <div class="box c-center">
              <nav aria-label="Article pagination">
                <ul class="pagination paginationD">
                  <%= paginate @articles %>
                </ul>
              </nav>
            </div>
          <% end %>
        </div>

        <div class="col-md-12 col-sm-12 col-lg-4">
          <div class="side-bar">
            <div class="email-form-wrap">
              <div class="email-form-inner">
                <div class="email-form-icon">
                  <%= image_tag "mail-icon.png", alt: "Newsletter subscription" %>
                </div>
                <div class="subscrb c-center">Subscribe<br>to Our Newsletter</div>
                <%= form_with url: '#', method: :post, local: true do |f| %>
                  <div class="search">
                    <%= f.label :email, "Enter Your Email ID", class: "sr-only" %>
                    <%= f.email_field :email, class: "form-control", placeholder: "Enter Your Email ID", required: true, aria: { describedby: "newsletter-help" } %>
                    <%= f.submit "Submit now", class: "btn search-btn hvr-rectangle-in", aria: { label: "Submit newsletter subscription" } %>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="category">
              <h3>Categories</h3>
              <ul>
                <% if @categories.any? %>
                  <% @categories.each do |category| %>
                    <li>
                      <%= link_to category, category_articles_path(category: category), 
                          class: (@current_category == category ? 'active' : ''),
                          aria: { label: "View articles in #{category} category" } %>
                    </li>
                  <% end %>
                <% else %>
                  <li>No categories available</li>
                <% end %>
              </ul>
            </div>

            <div class="category">
              <h3>Archives</h3>
              <ul>
                <% if @archives.any? %>
                  <% @archives.each do |archive| %>
                    <li>
                      <%= link_to Date.new(archive[:year].to_i, archive[:month].to_i, 1).strftime('%B %Y'), 
                          archive_articles_path(year: archive[:year], month: archive[:month]),
                          aria: { label: "View articles from #{Date.new(archive[:year].to_i, archive[:month].to_i, 1).strftime('%B %Y')}" } %>
                    </li>
                  <% end %>
                <% else %>
                  <li>No archives available</li>
                <% end %>
              </ul>
            </div>

            <div class="category-bann">
              <div class="cat-banner">
                <%= link_to services_index_path, aria: { label: "Learn more about our services" } do %>
                  <%= image_tag "cat-banner.png", alt: "Our Services" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <%= render(:partial => 'layouts/sec8interestedblock') %>
</main>

<%= render(:partial => 'layouts/footerjsblock') %>
